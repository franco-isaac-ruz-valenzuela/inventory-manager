rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verificar si el usuario está autenticado en el sistema
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: verificar si el usuario tiene rol de editor autorizado
    // Solo Franco.ruz.valenzuela@gmail.com y M.silva pueden editar productos
    function canEdit() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)franco\\.ruz\\.valenzuela@.*') ||
        request.auth.token.email.matches('(?i)m\\.?silva.*')
      );
    }

    // 1. Catálogo e Inventario de Productos
    // Usuarios autenticados pueden consultar; solo editores autorizados pueden crear, modificar o eliminar
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if canEdit();
    }

    // 2. Historial de Auditoría (Audit Log) - INMUTABLE
    // Cualquier usuario autenticado puede leer y registrar una nueva acción (create),
    // pero está ESTRICTAMENTE PROHIBIDO editar o borrar registros históricos.
    // Esto garantiza que nadie pueda alterar o borrar la evidencia de descuentos o cambios.
    match /audit_log/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 3. Notificaciones colaborativas en tiempo real
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Reportes y Sesiones de Comparación de Excel y Auditoría
    match /comparisons/{comparisonId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Conteo Físico y Auditoría en Vivo (Multi-dispositivo)
    match /active_physical_audit/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
