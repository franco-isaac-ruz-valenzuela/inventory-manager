rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editorIdentity() {
      return request.auth != null && (
        request.auth.uid == 'M5qscStYVWcZsm1gSFF2sMmN3Ek1' ||
        request.auth.uid == 'TadrO5T20Ka4g1vRUfDZBeNl5q22'
      );
    }
    function signedIn() {
      return request.auth != null && (editorIdentity() ||
        (exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.enabled == true));
    }
    function canEdit() { return editorIdentity(); }
    function canManageUsers() { return request.auth != null && request.auth.uid == 'TadrO5T20Ka4g1vRUfDZBeNl5q22'; }
    match /authorized_users/{userId} {
      allow get: if canManageUsers() || (request.auth != null && request.auth.uid == userId);
      allow list: if canManageUsers();
      allow create, update: if canManageUsers() &&
        !(userId in ['TadrO5T20Ka4g1vRUfDZBeNl5q22','M5qscStYVWcZsm1gSFF2sMmN3Ek1']) &&
        request.resource.data.keys().hasOnly(['enabled','email','name','updatedAt','updatedBy','operationId']) &&
        request.resource.data.enabled is bool && request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.timestamp == request.time &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.details.targetUserId == userId &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.details.enabled == request.resource.data.enabled;
      allow delete: if false;
    }
    function validProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'category', 'quantity', 'lastUpdated', 'updatedBy', 'lastMutationId']) &&
        data.keys().hasOnly(['sku', 'name', 'category', 'quantity', 'lastUpdated', 'updatedBy', 'lastMutationId', 'createdAt', 'lastAuditSession']) &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.quantity is number && data.quantity >= -1000000000 && data.quantity <= 1000000000 &&
        data.updatedBy == request.auth.uid && data.lastUpdated == request.time && data.lastMutationId is string;
    }
    function validMovement(productId, operationId, previous, next) {
      let operation = getAfter(/databases/$(database)/documents/audit_log/$(operationId)).data;
      return operation.userId == request.auth.uid && operation.timestamp == request.time &&
        operation.movements[productId].previousValue == previous && operation.movements[productId].newValue == next;
    }
    function validCountUpdate() {
      let key = request.resource.data.lastCountProductId;
      return key is string && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([key]) &&
        request.resource.data.updatedByMap.diff(resource.data.updatedByMap).affectedKeys().hasOnly([key]) &&
        request.resource.data.counts[key] is number &&
        request.resource.data.counts[key] >= 0 && request.resource.data.counts[key] <= 1000000000 &&
        request.resource.data.updatedByMap[key].userId == request.auth.uid;
    }
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if canEdit() && validProduct(request.resource.data) && request.resource.data.createdAt == request.time &&
        validMovement(productId, request.resource.data.lastMutationId, null, request.resource.data.quantity);
      allow update: if canEdit() && validProduct(request.resource.data) &&
        validMovement(productId, request.resource.data.lastMutationId, resource.data.quantity, request.resource.data.quantity) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if canEdit() &&
        getAfter(/databases/$(database)/documents/product_deletions/$(productId)).data.productData == resource.data &&
        getAfter(/databases/$(database)/documents/product_deletions/$(productId)).data.timestamp == request.time &&
        validMovement(productId, getAfter(/databases/$(database)/documents/product_deletions/$(productId)).data.operationId, resource.data.quantity, null);
    }
    match /product_deletions/{productId} {
      allow read: if canEdit();
      allow create, update: if canEdit() && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time &&
        request.resource.data.productData == get(/databases/$(database)/documents/products/$(productId)).data &&
        !existsAfter(/databases/$(database)/documents/products/$(productId));
      allow delete: if false;
    }
    match /audit_log/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasAll(['action', 'userId', 'userName', 'userEmail', 'timestamp', 'details']) &&
        request.resource.data.keys().hasOnly(['action', 'userId', 'userName', 'userEmail', 'timestamp', 'details', 'movements']) &&
        request.resource.data.userId == request.auth.uid && request.resource.data.userEmail == request.auth.token.email &&
        request.resource.data.timestamp == request.time && request.resource.data.details is map &&
        request.resource.data.action is string && request.resource.data.action.size() <= 80 &&
        request.resource.data.userName is string && request.resource.data.userName.size() <= 200 &&
        (canEdit() || request.resource.data.action in ['escaneo', 'reporte_descargado', 'comparacion_realizada', 'conteo_fisico_guardado']) &&
        (!('movements' in request.resource.data) || (canEdit() && request.resource.data.movements is map && request.resource.data.movements.size() <= 100));
      allow update, delete: if false;
    }
    match /order_receipts/{orderId} {
      allow read: if signedIn();
      allow create: if canEdit() && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/audit_log/$(request.resource.data.operationId)).data.details.notaPedido == request.resource.data.number;
      allow update, delete: if false;
    }
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['type', 'message', 'userId', 'userName', 'timestamp', 'readBy']) &&
        request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time &&
        request.resource.data.message is string && request.resource.data.message.size() <= 2000 && request.resource.data.readBy == [];
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.readBy is list && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1 &&
        request.resource.data.readBy.toSet() == resource.data.readBy.toSet().union([request.auth.uid].toSet());
      allow delete: if false;
    }
    match /inventory_sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.differences is list && request.resource.data.differences.size() <= 1000;
      allow update, delete: if false;
    }
    match /active_physical_audit/{docId} {
      allow read: if signedIn();
      allow create: if canEdit() && request.resource.data.lastUpdated == request.time &&
        request.resource.data.counts is map && request.resource.data.counts.size() <= 3000;
      allow update: if signedIn() && request.resource.data.lastUpdated == request.time &&
        request.resource.data.counts is map && request.resource.data.counts.size() <= 3000 &&
        (canEdit() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'updatedByMap', 'lastUpdated', 'lastUpdatedBy', 'lastCountProductId']) &&
          request.resource.data.counts.diff(resource.data.counts).removedKeys().size() == 0 &&
          validCountUpdate()));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
